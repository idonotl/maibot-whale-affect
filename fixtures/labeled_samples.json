      "expected_target": "other",
      "expected_event": null,
      "note": "骂游戏角色/第三方不扣她的 F"
    },
    {
      "id": "T17-group-no-target",
      "text": "今天中午吃什么好呢",
      "scene": "group",
      "at": false,
      "expected_target": "other",
      "expected_event": null,
      "note": "群体旁听消息不进入计分"
    },
