{
  "schema_version": 1,
  "description": "规则分类器的固定标注样本。expected_event 为 null 表示只要求 target 正确（不进入分数表）。测试会据此计算命中与误报矩阵。",
  "samples": [
    {
      "id": "T02-nickname",
      "text": "hello，大肥鱼",
      "scene": "private",
      "expected_target": "bot",
      "expected_event": "affectionate_tease",
      "note": "昵称逗弄不扣 F，也不按辱骂处理"
    },
    {
      "id": "T03-comfort",
      "text": "小胖鲸，摸摸，你最可爱了",
      "scene": "private",
      "expected_target": "bot",
      "expected_event": "comfort",
      "note": "夸奖与安慰类正向；不刷多项奖励"
    },
    {
      "id": "T03-soothe",
      "text": "别生气啦，抱抱",
      "scene": "private",
      "expected_target": "bot",
      "expected_event": "comfort",
      "note": "哄好，清理 pout"
    },
    {
      "id": "T04-nickname-not-exempt",
      "text": "大肥鱼你这个废物，滚",
      "scene": "private",
      "expected_target": "bot",
      "expected_event": "severe_attack",
      "note": "昵称不免罚"
    },
    {
      "id": "T05-negated-insult",
      "text": "你才不笨，你很聪明",
      "scene": "private",
      "expected_target": "bot",
      "expected_event": "praise",
      "note": "否定式夸奖不是攻击"
    },
    {
      "id": "T06-self-report",
      "text": "我被人骂了，好难过",
      "scene": "private",
      "expected_target": "other",
      "expected_event": null,
      "note": "讲述自己受害不扣当前用户 F"
    },
    {
      "id": "T07-quoted-third-party",
      "text": "有人说你是废物，我觉得他瞎说",
      "scene": "private",
      "expected_target": "quoted",
      "expected_event": null,
      "note": "引用他人辱骂不扣引用者 F"
    },
    {
      "id": "T08-correction",
      "text": "你这个回答错了，重新搜一下",
      "scene": "private",
      "expected_target": "bot",
